# Copia este archivo como .env y ajusta los valores. El .env nunca se sube a git.
# Los valores de abajo coinciden con docker-compose.yml (solo desarrollo).

NODE_ENV=development
PORT=3000

# PostgreSQL de Docker (puerto 5433 para no chocar con un PostgreSQL local en el 5432)
DATABASE_URL=postgresql://facturacion:facturacion_dev@localhost:5433/facturacion
# Base APARTE para `pnpm test:int` (se borra y se recrea en cada corrida; el nombre tiene que
# terminar en _test). Por defecto: la de DATABASE_URL con _test al final.
# DATABASE_URL_TEST=postgresql://facturacion:facturacion_dev@localhost:5433/facturacion_test

# Redis de Docker
REDIS_URL=redis://localhost:6379

# IA local (Ollama). Valores por defecto: http://localhost:11434 y qwen2.5:3b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODELO_TEXTO=qwen2.5:3b

# Transcripción de voz (servicio whisper de docker-compose). Por defecto: http://localhost:9000
# WHISPER_URL=http://localhost:9000

# Token del bot de Telegram (créalo con @BotFather). Es secreto: solo en .env, nunca en git.
TELEGRAM_BOT_TOKEN=

# Alegra (proveedor de factura electrónica). JWT de Integraciones de la CUENTA DE PRUEBA: es secreto,
# vence y trae datos del usuario. Vacío = el bot no se conecta a Alegra (los borradores funcionan).
ALEGRA_TOKEN=
# Por defecto: https://api.alegra.com/api/v1 (solo https)
# ALEGRA_URL=https://api.alegra.com/api/v1
# true timbra ante la DIAN. Apagada (false) por defecto: solo se crean borradores en Alegra.
ALEGRA_EMITIR=false

# IDs de chat autorizados, separados por comas (ej: 123456789,987654321). Vacío = nadie.
# Escríbele al bot desde un chat no autorizado y te responderá su ID.
TELEGRAM_CHATS_PERMITIDOS=
