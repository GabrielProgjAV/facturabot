# Copia este archivo como .env y ajusta los valores. El .env nunca se sube a git.
# Los valores de abajo coinciden con docker-compose.yml (solo desarrollo).

NODE_ENV=development
PORT=3000

# PostgreSQL de Docker (puerto 5433 para no chocar con un PostgreSQL local en el 5432)
DATABASE_URL=postgresql://facturacion:facturacion_dev@localhost:5433/facturacion

# Redis de Docker
REDIS_URL=redis://localhost:6379

# IA local (Ollama). Valores por defecto: http://localhost:11434 y qwen2.5:3b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODELO_TEXTO=qwen2.5:3b

# Token del bot de Telegram (créalo con @BotFather). Es secreto: solo en .env, nunca en git.
TELEGRAM_BOT_TOKEN=

# IDs de chat autorizados, separados por comas (ej: 123456789,987654321). Vacío = nadie.
# Escríbele al bot desde un chat no autorizado y te responderá su ID.
TELEGRAM_CHATS_PERMITIDOS=
