# Copia este archivo como .env y ajusta los valores. El .env nunca se sube a git.
# Los valores de abajo coinciden con docker-compose.yml (solo desarrollo).

NODE_ENV=development
PORT=3000

# PostgreSQL de Docker (puerto 5433 para no chocar con un PostgreSQL local en el 5432)
DATABASE_URL=postgresql://facturacion:facturacion_dev@localhost:5433/facturacion

# Redis de Docker
REDIS_URL=redis://localhost:6379
