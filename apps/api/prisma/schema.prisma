// Esquema de la base de datos. Cada cambio aquí se aplica con una migración:
//   pnpm run db:migrate --name <descripcion>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // partialIndexes sigue en preview: Prisma va fijado en 7.10.0 exacta. Subirlo es un PR aparte que
  // revisa sus notas de versión y corre `pnpm test:int` (prueba del índice único de Borrador).
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Software de facturación electrónica (proveedor autorizado por la DIAN) que usa la empresa.
enum ProveedorFacturacion {
  ALEGRA
  SIIGO
}

/// SIMPLE: una línea genérica con el total. DETALLADO: una línea por producto del catálogo.
enum ModoLineas {
  SIMPLE
  DETALLADO
}

enum EstadoBorrador {
  PENDIENTE
  APROBADO
  CANCELADO
}

/// Factura en conversación con un chat. A lo sumo uno PENDIENTE por chat (índice único parcial).
/// `datos` guarda un BorradorFactura (src/facturacion/factura.ts) como JSON: su forma aún cambia.
/// TODO: sin empresaId hasta que exista la relación chat → empresa (piloto multiempresa).
model Borrador {
  id              String         @id @default(uuid(7)) @db.Uuid
  chatId          BigInt         @map("chat_id")
  estado          EstadoBorrador @default(PENDIENTE)
  datos           Json
  /// Sube en 1 con cada escritura de `datos`.
  version         Int            @default(1)
  /// Última versión cuyo resumen Telegram confirmó haber recibido. Null = nunca se mostró.
  versionMostrada Int?           @map("version_mostrada")
  creadoEn        DateTime       @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn   DateTime       @updatedAt @map("actualizado_en") @db.Timestamptz

  @@unique([chatId], where: raw("estado = 'PENDIENTE'"), map: "borradores_chat_id_pendiente_key")
  @@index([chatId, estado])
  @@map("borradores")
}

/// Comercio que usa el bot. Todas las tablas futuras (clientes, borradores, facturas)
/// pertenecen a una empresa: así el sistema es multiempresa desde el inicio.
model Empresa {
  id            String               @id @default(uuid(7)) @db.Uuid
  nombre        String
  /// NIT sin dígito de verificación.
  nit           String               @unique
  proveedor     ProveedorFacturacion
  modoLineas    ModoLineas           @default(SIMPLE) @map("modo_lineas")
  creadaEn      DateTime             @default(now()) @map("creada_en") @db.Timestamptz
  actualizadaEn DateTime             @updatedAt @map("actualizada_en") @db.Timestamptz

  @@map("empresas")
}
