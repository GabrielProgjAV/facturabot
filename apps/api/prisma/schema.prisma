// Esquema de la base de datos. Cada cambio aquí se aplica con una migración:
//   pnpm run db:migrate --name <descripcion>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // partialIndexes sigue en preview: Prisma va fijado en 7.10.0 exacta. Subirlo es un PR aparte que
  // revisa sus notas de versión y corre `pnpm test:int` (prueba del índice único de Borrador).
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Software de facturación electrónica (proveedor autorizado por la DIAN) que usa la empresa.
enum ProveedorFacturacion {
  ALEGRA
  SIIGO
}

/// SIMPLE: una línea genérica con el total. DETALLADO: una línea por producto del catálogo.
enum ModoLineas {
  SIMPLE
  DETALLADO
}

enum EstadoBorrador {
  PENDIENTE
  APROBADO
  CANCELADO
}

/// Factura en conversación con un chat. A lo sumo uno PENDIENTE por chat (índice único parcial).
/// `datos` guarda un BorradorFactura (src/facturacion/factura.ts) como JSON: su forma aún cambia.
/// TODO: sin empresaId hasta que exista la relación chat → empresa (piloto multiempresa).
model Borrador {
  id              String          @id @default(uuid(7)) @db.Uuid
  chatId          BigInt          @map("chat_id")
  estado          EstadoBorrador  @default(PENDIENTE)
  datos           Json
  /// Sube en 1 con cada escritura de `datos`.
  version         Int             @default(1)
  /// Última versión cuyo resumen Telegram confirmó haber recibido. Null = nunca se mostró.
  versionMostrada Int?            @map("version_mostrada")
  /// Id de Telegram del usuario que pulsó "✅ Aprobar" (4.4 §3.5). Dato personal: nunca va a los logs.
  aprobadoPor     BigInt?         @map("aprobado_por")
  /// Fecha y hora exacta de la aprobación (actualizadoEn cambia con cualquier escritura).
  aprobadoEn      DateTime?       @map("aprobado_en") @db.Timestamptz
  /// A dónde va la venta, fijado al aprobar y para siempre (null mientras está PENDIENTE).
  destinoFactura  DestinoFactura? @map("destino_factura")
  creadoEn        DateTime        @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn   DateTime        @updatedAt @map("actualizado_en") @db.Timestamptz
  /// La emisión de este borrador, si ya se aprobó (a lo sumo una: `Emision.borradorId` es único).
  emision         Emision?

  @@unique([chatId], where: raw("estado = 'PENDIENTE'"), map: "borradores_chat_id_pendiente_key")
  @@index([chatId, estado])
  @@map("borradores")
}

/// A dónde va una venta aprobada (decisiones de Gabriel del 2026-11-12, plan de la fase 5 §4).
/// Se fija al aprobar y no cambia nunca: solo PROVEEDOR puede tener emisión.
enum DestinoFactura {
  /// Se emite con el proveedor (consumidor final, con token válido).
  PROVEEDOR
  /// No había token válido al aprobar: se factura a mano y nunca se emite después (duplicaría).
  MANUAL
  /// Con NIT o cédula: el bot todavía no emite a nombre de alguien (paso 7). No se factura.
  SIN_FACTURA
}

/// Dónde va una emisión (docs/planes/fase-5-alegra.md §4). Ver el modelo Emision.
enum EstadoEmision {
  /// Nació junto con la aprobación (bandeja de salida); todavía no tocó al proveedor.
  PENDIENTE
  /// Se guardó justo antes del POST que crea el borrador en el proveedor (paso 1).
  CREANDO_BORRADOR
  /// El proveedor creó su borrador y su id está en `idExterno`.
  BORRADOR_CREADO
  /// Se guardó justo antes de pedir el timbrado (paso 2). Repetirlo no duplica.
  TIMBRANDO
  /// Timbrada: tiene número; el resultado de la DIAN va en `estadoDian`.
  EMITIDA
  /// El proveedor rechazó el timbrado de esa factura. Se resuelve a mano en su web.
  RECHAZADA
  /// Error definitivo al crear el borrador (400 sin factura, 401, 402, 403, 429): no existe nada.
  NO_CREADA
  /// Timeout o respuesta rara al crear: no se sabe si existe. Se reconcilia; nunca se repite solo.
  DESCONOCIDO
  /// El usuario dijo que ya la facturó a mano (plan B) antes de que saliera: no se emite.
  CANCELADA
}

/// Con qué valor de ALEGRA_EMITIR nació la emisión. Una fila SOLO_BORRADOR nunca se timbra, aunque
/// después se encienda la bandera o cambie el token (§4, hallazgo alto de la revisión del PR #8).
enum ModoEmision {
  /// ALEGRA_EMITIR apagada (desarrollo): termina en BORRADOR_CREADO.
  SOLO_BORRADOR
  /// ALEGRA_EMITIR encendida: crea el borrador y lo timbra ante la DIAN.
  TIMBRAR
}

/// Resultado de la DIAN, en nuestros términos (no los nombres de estado de Alegra).
enum EstadoDian {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

/// Emisión de un borrador aprobado ante el proveedor de facturación (fase 5, §4 del plan).
/// Un borrador produce como máximo una emisión (`borradorId` único) y, por el diseño en dos tiempos,
/// como máximo una factura. Las reglas de "solo timbrar lo propio" se refuerzan en la base con
/// restricciones CHECK y triggers escritos a mano (Prisma no los modela), en las migraciones
/// `crear_emisiones` y `proteger_emisiones`: borrador, proveedor, cuenta y modo no cambian; el id
/// externo se guarda una vez; EMITIDA y CANCELADA son finales; solo nace de un borrador APROBADO; y
/// un borrador que ya no está PENDIENTE no cambia. Las prueba `emision-restricciones.int-spec.ts`.
model Emision {
  id                    String               @id @default(uuid(7)) @db.Uuid
  /// Un borrador, una emisión. Restrict: no se puede borrar un borrador que ya tiene emisión.
  borradorId            String               @unique @map("borrador_id") @db.Uuid
  borrador              Borrador             @relation(fields: [borradorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proveedor             ProveedorFacturacion
  /// Id de la cuenta (compañía) del proveedor con la que nació. Antes de timbrar se exige que sea la
  /// cuenta del token actual: una fila de la cuenta de prueba nunca se timbra en la real.
  cuentaProveedor       String               @map("cuenta_proveedor")
  modo                  ModoEmision
  estado                EstadoEmision        @default(PENDIENTE)
  /// Fecha de la factura que se envía (día de Colombia), fijada al nacer: la reconciliación busca
  /// por esta fecha aunque se reintente otro día.
  fechaFactura          DateTime             @map("fecha_factura") @db.Date
  /// Id de la factura en el proveedor (texto: Alegra pasa a UUID). Null hasta crear el borrador.
  idExterno             String?              @map("id_externo")
  /// Número de la factura (con prefijo), al timbrar.
  numero                String?
  cufe                  String?
  estadoDian            EstadoDian?          @map("estado_dian")
  /// Código del último error (p. ej. "http_401", "alegra_3226"). Nunca texto con datos personales.
  codigoError           String?              @map("codigo_error")
  creadaEn              DateTime             @default(now()) @map("creada_en") @db.Timestamptz
  actualizadaEn         DateTime             @updatedAt @map("actualizada_en") @db.Timestamptz
  emitidaEn             DateTime?            @map("emitida_en") @db.Timestamptz
  /// Quién confirmó con el botón "No existe en Alegra" (DESCONOCIDO → NO_CREADA) y cuándo.
  /// Id de Telegram: dato personal, nunca va a los logs.
  noExisteConfirmadoPor BigInt?              @map("no_existe_confirmado_por")
  noExisteConfirmadoEn  DateTime?            @map("no_existe_confirmado_en") @db.Timestamptz
  /// Quién eligió "Ya la facturé a mano" (PENDIENTE o NO_CREADA → CANCELADA) y cuándo. Dato personal.
  canceladaPor          BigInt?              @map("cancelada_por")
  canceladaEn           DateTime?            @map("cancelada_en") @db.Timestamptz

  /// Una factura del proveedor pertenece a una sola emisión (la reconciliación no puede adoptarla
  /// dos veces). Los NULL no chocan entre sí en PostgreSQL.
  @@unique([proveedor, cuentaProveedor, idExterno], map: "emisiones_proveedor_cuenta_id_externo_key")
  /// La recuperación al arrancar busca por estado.
  @@index([estado])
  @@map("emisiones")
}

/// Comercio que usa el bot. Todas las tablas futuras (clientes, borradores, facturas)
/// pertenecen a una empresa: así el sistema es multiempresa desde el inicio.
model Empresa {
  id            String               @id @default(uuid(7)) @db.Uuid
  nombre        String
  /// NIT sin dígito de verificación.
  nit           String               @unique
  proveedor     ProveedorFacturacion
  modoLineas    ModoLineas           @default(SIMPLE) @map("modo_lineas")
  creadaEn      DateTime             @default(now()) @map("creada_en") @db.Timestamptz
  actualizadaEn DateTime             @updatedAt @map("actualizada_en") @db.Timestamptz

  @@map("empresas")
}
